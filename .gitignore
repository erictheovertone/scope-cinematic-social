# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next
/.next.delete-*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
# Local media library — multi-GB source media, never commit (GitHub rejects >100MB files)
public/music-library/

# Brief C2 — create-pipeline harness (local session + reports)
test/.auth/
test/.report/
test-results/
test/.perf/

# C3 harness self-verify screenshots (not source)
test/shots/

# V1e — generated video fixtures + harness shots (not source)
public/test-fixtures/
test/shots-v1/
test/shots-mx/
# MUS-2 harness screenshots (not source)
test/shots-mus2/
# ARR-6 — Arrival closed-state shots (not source)
test/shots-arr6/
test/shots-arr7/

{
  "name": "scope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "node scripts/check-canvas-tokens.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "create:fixtures": "node test/fixtures/create/generate.mjs",
    "create:login": "node test/create-login.mjs",
    "create:matrix": "playwright test test/create-matrix.spec.ts",
    "check:canvas": "node scripts/check-canvas-tokens.mjs",
    "create:login:test": "AUTH_STATE=test/.auth/throwaway.json node test/create-login.mjs",
    "create:matrix:test": "AUTH_STATE=test/.auth/throwaway.json playwright test test/create-matrix.spec.ts --workers=1",
    "create:restore": "node test/restore-layout.mjs",
    "create:perf": "playwright test test/create-perf.spec.ts --project=desktop-chromium"
  },
  "dependencies": {
    "@privy-io/react-auth": "^2.25.0",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/supabase-js": "^2.78.0",
    "@zoralabs/coins-sdk": "^0.8.0",
    "@zoralabs/protocol-sdk": "^0.13.21",
    "bs58": "^6.0.0",
    "framer-motion": "^12.23.12",
    "gl-react": "^6.0.0",
    "gl-react-dom": "^6.0.0",
    "hls.js": "^1.6.16",
    "next": "^16.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.1.1",
    "vercel": "^50.43.0",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
